{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Nix flake input updates into a single PR",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "groupName": "Nix flake inputs",
      "groupSlug": "nix-flake-inputs"
    },
    {
      "description": "Group non-major CI action updates in .forgejo/workflows; major bumps get their own PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "groupName": "CI workflow actions",
      "groupSlug": "ci-workflow-actions"
    },
    {
      "description": "Link the uv CLI Docker image to its GitHub repository for release notes",
      "matchDatasources": ["docker"],
      "matchDepNames": ["ghcr.io/astral-sh/uv"],
      "sourceUrl": "https://github.com/astral-sh/uv"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Python version in .python-version, preserving any uv flavour suffix such as +gil or +freethreaded",
      "managerFilePatterns": ["/(^|/)\\.python-version$/"],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)(?<suffix>\\+[A-Za-z0-9._-]+)?\\s*$"
      ],
      "autoReplaceStringTemplate": "{{{newValue}}}{{{suffix}}}",
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    },
    {
      "customType": "regex",
      "description": "Keep version-pinned jsDelivr CDN references in templates up to date",
      "managerFilePatterns": ["/(^|/)src/.+\\.html$/"],
      "matchStrings": [
        "https://cdn\\.jsdelivr\\.net/npm/(?<depName>@?[^\"'\\s\\[\\]]+?)@(?<currentValue>\\d+(?:\\.\\d+){1,2})"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm",
      "autoReplaceStringTemplate": "https://cdn.jsdelivr.net/npm/{{{depName}}}@{{{newValue}}}"
    }
  ]
}
